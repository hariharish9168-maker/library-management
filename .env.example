# =============================================================================
# SMART LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================

# Runtime Environment
NODE_ENV=development
PORT=5000

# Security & Authentication
JWT_SECRET=super_secret_jwt_library_key_replace_in_production_2026
JWT_EXPIRES_IN=24h

# Database Driver: 'mysql' (Default) | 'sqlite' | 'auto' (Auto-detects MySQL with SQLite fallback)
DB_TYPE=auto

# MySQL Database Configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=smart_library
DATABASE_USER=root
DATABASE_PASSWORD=

# SQLite Local Database File (Used when DB_TYPE=sqlite or MySQL is offline)
SQLITE_PATH=./database/smart_library.sqlite

# Client & API URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=/api
